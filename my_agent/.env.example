# Gemini. Set one of these. If both are set, GOOGLE_API_KEY is used.
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional. The default agents do not read this. Only for a LiteLLM/Groq experiment.
GROQ_API_KEY=your_groq_api_key

# Optional. Public GitHub requests work without it. A classic PAT raises the rate limit.
GITHUB_TOKEN=your_github_personal_access_token
